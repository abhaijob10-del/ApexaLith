# Server-only variables. Merge these into the ignored .env.local for local development.
NODE_ENV=development
# Dedicated local database. Replace placeholders privately in .env.local.
DATABASE_URL=postgresql://apexalith_app:CHANGE_ME@127.0.0.1:5432/apexalith_dev
HOST=127.0.0.1
PORT=3000
# Customer authentication. Set NODE_ENV=development explicitly for local OTP tests.
OTP_PROVIDER=
OTP_SECRET=
DEV_OTP=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_TEMPLATE=
APP_ORIGIN=http://127.0.0.1:3000

MEDIA_STORAGE=local
MEDIA_DIR=
S3_REGION=
S3_BUCKET=
S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
MFA_ENCRYPTION_KEY=
TRUSTED_PROXY=
